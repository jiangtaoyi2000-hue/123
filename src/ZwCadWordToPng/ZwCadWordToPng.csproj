<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    中望CAD Word 转 PNG 插件

    构建前请设置环境变量 ZwCadInstallDir 指向您本机的中望CAD安装目录,
    例如 C:\Program Files\ZWSOFT\ZWCAD 2024
    其中包含 ZwCADMgd.dll 与 ZwCADDbMgd.dll 两个托管程序集。

    也可以直接在下面的 <HintPath> 中修改为绝对路径。
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{8B4E2A8B-0001-4CAD-9F00-00A5B6A4A001}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>ZwCadWordToPng</RootNamespace>
    <AssemblyName>ZwCadWordToPng</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <ZwCadInstallDir Condition=" '$(ZwCadInstallDir)' == '' ">C:\Program Files\ZWSOFT\ZWCAD 2024</ZwCadInstallDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET Framework 基础引用 -->
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />

    <!-- 中望CAD .NET API -->
    <Reference Include="ZwCADMgd">
      <HintPath>$(ZwCadInstallDir)\ZwCADMgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>
    <Reference Include="ZwCADDbMgd">
      <HintPath>$(ZwCadInstallDir)\ZwCADDbMgd.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>False</SpecificVersion>
    </Reference>

    <!-- Office Word Interop (通过 NuGet 恢复, 具体 NuGet 包请见 packages.config) -->
    <Reference Include="Microsoft.Office.Interop.Word">
      <HintPath>..\..\packages\Microsoft.Office.Interop.Word.15.0.4797.1004\lib\net20\Microsoft.Office.Interop.Word.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Office">
      <HintPath>..\..\packages\Microsoft.Office.Interop.Word.15.0.4797.1004\lib\net20\Office.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Vbe.Interop">
      <HintPath>..\..\packages\Microsoft.Office.Interop.Word.15.0.4797.1004\lib\net20\Microsoft.Vbe.Interop.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>

    <!-- PDFium 渲染 PDF 到图像 -->
    <Reference Include="PdfiumViewer">
      <HintPath>..\..\packages\PdfiumViewer.2.13.0.0\lib\net40\PdfiumViewer.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="WordToPngCommand.cs" />
    <Compile Include="WordConverter.cs" />
    <Compile Include="CadImageInserter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
    <None Include="ZwCadWordToPng.ldr" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
